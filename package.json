{
  "name": "r3f-vs-threejs-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "Исследовательский стенд для сравнения производительности three.js и react-three-fiber",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:threejs": "npm run dev -w @bench/impl-threejs",
    "dev:r3f": "npm run dev -w @bench/impl-r3f",
    "preview:threejs": "npm run preview -w @bench/impl-threejs",
    "preview:r3f": "npm run preview -w @bench/impl-r3f",
    "build": "npm run build -w @bench/impl-threejs && npm run build -w @bench/impl-r3f",
    "typecheck": "tsc --noEmit -p packages/scene-spec && tsc --noEmit -p packages/metrics && tsc --noEmit -p packages/impl-threejs && tsc --noEmit -p packages/impl-r3f && tsc --noEmit -p packages/harness",
    "browsers": "playwright install chromium firefox webkit",
    "bench": "npm run bench -w @bench/harness --",
    "campaign": "npm run campaign -w @bench/harness --",
    "bench:parity": "npm run bench -w @bench/harness -- --parity-only --scenario",
    "bench:s1": "npm run bench -w @bench/harness -- --scenario s1",
    "bench:s2": "npm run bench -w @bench/harness -- --scenario s2",
    "bench:s3": "npm run bench -w @bench/harness -- --scenario s3",
    "bench:s4": "npm run bench -w @bench/harness -- --scenario s4",
    "bench:s5": "npm run bench -w @bench/harness -- --scenario s5",
    "clean": "rm -rf packages/*/dist node_modules"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
